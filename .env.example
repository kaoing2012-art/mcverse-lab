# McVerse Lab 环境变量示例
#
# 重要：本项目不会自动读取 .env 文件（没有引入 dotenv，也没有任何 dotenv 依赖）。
# 本文件仅用于说明可用的环境变量名，请按下面的方式设置，而不是"复制成 .env 就生效"。
#
# Token 只支持以下两种来源（按优先级）：
#   1) 环境变量 MCD_MCP_TOKEN
#         Windows PowerShell : $env:MCD_MCP_TOKEN="你的Token"
#         Windows CMD        : set MCD_MCP_TOKEN=你的Token
#         macOS / Linux      : export MCD_MCP_TOKEN=你的Token
#   2) 文件 ~/.config/mcd/mcp_token（文件内容只放 Token 本身，不要加引号或前缀）
#
# 申请 Token：https://open.mcd.cn/mcp （手机号登录 → 控制台 → 激活 → 复制）
# 请勿把真实 Token 提交到 Git 仓库。

MCD_MCP_TOKEN=YOUR_MCP_TOKEN

# 本地演示服务器端口（可选，默认 3000）
MCVERSE_PORT=3000
